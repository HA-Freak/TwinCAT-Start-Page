<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>TwinCAT.XAE.StartPage.TcXaeShell64</id>
    <version>1.1.47</version>
    <title>TwinCAT Start Page (TcXaeShell64 integration)</title>
    <authors>HA-Freak</authors>
    <description>TcXaeShell64 shell integration for the TwinCAT Start Page extension. Installed automatically by the TwinCAT.XAE.StartPage package.</description>
    <summary>Start page extension - TcXaeShell64 shell integration</summary>
    <!-- UpdateConfigurationOption lets TcPkg refresh the shell's extension configuration after install -->
    <tags>Setup UpdateConfigurationOption</tags>
    <projectUrl>https://github.com/HA-Freak/TwinCAT-Start-Page</projectUrl>
    <icon>images\icon.png</icon>
    <dependencies>
      <dependency id="TwinCAT.XAE.Shell64" />
    </dependencies>
  </metadata>
  <files>
    <file src="..\icon.png" target="images" />
    <file src="tools\**" target="tools" />
    <file src="..\..\bin\Debug\TwinCAT.XAE.StartPage.msi" target="tools" />
  </files>
</package>
