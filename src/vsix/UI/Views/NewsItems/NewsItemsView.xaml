<UserControl
    x:Class="TwinCAT.XAE.StartPage.UI.Views.NewsItems.NewsItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:b="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:c="clr-namespace:TwinCAT.XAE.StartPage.UI.Converters"
    xmlns:catalog="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.ImageCatalog"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dat="clr-namespace:System.Windows.Data;assembly=PresentationFramework"
    xmlns:grid="clr-namespace:TwinCAT.XAE.StartPage.UI.AttachedProperties.Grids"
    xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:scm="clr-namespace:System.ComponentModel;assembly=WindowsBase"
    xmlns:pui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    xmlns:utilities="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Utilities"
    d:DesignHeight="450"
    d:DesignWidth="800"
    IsTabStop="False"
    mc:Ignorable="d"
    >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TwinCAT.XAE.StartPage;component/Resources/Brushes.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/TwinCAT.XAE.StartPage;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <utilities:BrushToColorConverter x:Key="BrushToColorConverter"/>

            <!-- https://stackoverflow.com/questions/3894195/wpf-collectionviewsource-grouping -->
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <!-- minimized: a vertical 'News' tab at the right edge, like the TwinCAT 3 start page -->
        <Button x:Name="NewsStrip"
            Width="30"
            Height="250"
            Margin="0,10,10,10"
            VerticalAlignment="Top"
            Command="{Binding ToggleMinimizedCommand}"
            Cursor="Hand"
            IsTabStop="False"
            ToolTip="Show news"
            Visibility="{Binding IsMinimized, Converter={c:BoolToVisibilityConverter}}"
            >
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border
                        Background="{DynamicResource ColumnBackgroundBrush}"
                        BorderBrush="{DynamicResource ColumnBorderBrush}"
                        BorderThickness="1"
                        >
                        <TextBlock x:Name="StripText"
                            Margin="0,8,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            FontFamily="{StaticResource DefaultFont}"
                            FontSize="15"
                            FontWeight="Medium"
                            Foreground="{DynamicResource ColumnHeadingBrush}"
                            Text="{Binding Heading}"
                            >
                            <TextBlock.LayoutTransform>
                                <RotateTransform Angle="90"/>
                            </TextBlock.LayoutTransform>
                        </TextBlock>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="StripText" Property="Foreground" Value="{DynamicResource CommandMouseOverBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>

        <Border
            pui:ImageThemingUtilities.ImageBackgroundColor="{Binding Background.Color, RelativeSource={RelativeSource Self}}"
            Style="{StaticResource ColumnStyle}"
            Visibility="{Binding IsMinimized, Converter={c:BoolToVisibilityConverter Reverse=True}}"
            >
            <DockPanel x:Name="LayoutRoot"
                LastChildFill="true"
                >
                <DockPanel DockPanel.Dock="Top">
                    <Button x:Name="MinimizeButton"
                        Margin="0,10,10,5"
                        VerticalAlignment="Center"
                        Command="{Binding ToggleMinimizedCommand}"
                        Cursor="Hand"
                        DockPanel.Dock="Right"
                        IsTabStop="False"
                        ToolTip="Minimize news"
                        >
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border
                                    Padding="4"
                                    Background="Transparent"
                                    >
                                    <TextBlock x:Name="MinimizeGlyph"
                                        FontFamily="Segoe MDL2 Assets"
                                        FontSize="12"
                                        Foreground="{DynamicResource ColumnHeadingBrush}"
                                        Text="&#xE76C;"
                                        />
                                </Border>

                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="MinimizeGlyph" Property="Foreground" Value="{DynamicResource CommandMouseOverBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <TextBlock x:Name="Heading"
                        Style="{StaticResource ColumnHeadingStyle}"
                        Text="{Binding Heading}"
                        />
                </DockPanel>

                <Grid x:Name="NewsItemFilterContainer"
                    Margin="10,0,10,6"
                    DockPanel.Dock="Top"
                    >
                    <TextBox x:Name="FilterTextBox"
                        Grid.Column="0"
                        Background="{DynamicResource FilterBackgroundBrush}"
                        FocusManager.FocusedElement="{Binding ElementName=FilterTextBox}"
                        FontFamily="{StaticResource DefaultFont}"
                        FontSize="14"
                        Foreground="{DynamicResource FilterForegroundBrush}"
                        IsTabStop="true"
                        />
                    <Button x:Name="ClearFilterTextButton"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        HorizontalContentAlignment="Center"
                        VerticalContentAlignment="Center"
                        Background="{Binding Background, ElementName=FilterTextBox}"
                        BorderBrush="Transparent"
                        Click="ClearFilterText_Click"
                        IsTabStop="False"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"
                        >
                        <imaging:CrispImage x:Name="ClearFilterImage"
                            Width="16"
                            Height="16"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Moniker="{x:Static catalog:KnownMonikers.Close}"
                            />
                    </Button>
                </Grid>

                <ItemsControl x:Name="NewsItemCommands"
                    Style="{StaticResource ColumnCommandsStyle}"
                    />

                <ListView x:Name="NewsItemsListView"
                    IsTabStop="False"
                    ItemContainerStyle="{StaticResource ColumnListItemContainerStyle}"
                    ItemsSource="{Binding Items}"
                    SelectionChanged="OnSelectionChanged"
                    Style="{StaticResource ColumnListStyle}"
                    >
                    <!--<ListView.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="IsTabStop" Value="False"/>
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="{x:Type GroupItem}">
                                                <Expander
                                                    Collapsed="OnCollapsed"
                                                    Expanded="OnExpanded"
