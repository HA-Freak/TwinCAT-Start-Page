                        </GroupStyle>
                    </ListView.GroupStyle>-->

                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <Button x:Name="NewsItemButton"
                                Command="{Binding SelectItemCommand}"
                                IsTabStop="False"
                                Style="{StaticResource ColumnListItemStyle}"
                                >
                                <!--<Button.ToolTip>
                                    <ToolTip x:Name="NewsItemTooltip" 
                                        MaxWidth="500" 
                                        MaxHeight="500"
                                        >
                                        <StackPanel Orientation="Vertical">
                                            <TextBlock 
                                                Style="{StaticResource NewsItemTitleStyle}"
                                                Text="{Binding Title}"
                                                TextWrapping="WrapWithOverflow"
                                                />
                                            <TextBlock Text="{Binding Description}"
                                                Style="{StaticResource NewsItemDescriptionStyle}"
                                                TextWrapping="WrapWithOverflow"
                                                />
                                            <TextBlock Text="{Binding Link}"
                                                Style="{StaticResource NewsItemLinkStyle}"
                                                />
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>-->

                                <DockPanel x:Name="NewsItemContainer"
                                    Margin="0,0,0,5"
                                    >
                                    <TextBlock x:Name="NewsItemTitle"
                                        Style="{StaticResource NewsItemTitleStyle}"
                                        DockPanel.Dock="Top"
                                        Text="{Binding Title}"
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="NoWrap"
                                        Foreground="#4eaffc"
                                        />

                                    <TextBlock x:Name="NewsItemDescription"
                                        Style="{StaticResource NewsItemDescriptionStyle}"
                                        DockPanel.Dock="Top"
                                        MaxHeight="50"
                                        Text="{Binding Description}"        
                                        TextTrimming="WordEllipsis"
                                        TextWrapping="Wrap"
                                        />

                                    <StackPanel x:Name="DatePanel"
                                        Margin="0,4,0,0"
                                        DockPanel.Dock="Top"
                                        Orientation="Horizontal"
                                        >
                                        <TextBlock x:Name="NewsItemNewIndicator"
                                            FontFamily="{StaticResource DefaultFont}"
                                            FontSize="10"
                                            Foreground="Orange"
                                            Text="{Binding New}"
                                            Visibility="Collapsed"
                                            />

                                        <TextBlock x:Name="NewsItenDate"
                                            FontFamily="{StaticResource DefaultFont}"
                                            FontSize="11"
                                            FontWeight="Medium"
                                            Foreground="{DynamicResource ItemDateBrush}"
                                            Text="{Binding Date, StringFormat='dddd, d MMMM yyyy, HH:mm'}"
                                            />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                        </DataTemplate>
                    </ListView.ItemTemplate>

