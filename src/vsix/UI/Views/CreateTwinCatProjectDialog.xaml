<pui:DialogWindow
    x:Class="TwinCAT.XAE.StartPage.UI.Views.CreateTwinCatProjectDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:pui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    Title="Create a TwinCAT project"
    Width="760"
    SizeToContent="Height"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    HasMinimizeButton="False"
    HasMaximizeButton="False"
    pui:ThemedDialogStyleLoader.UseDefaultThemedDialogStyles="True"
    Background="{DynamicResource {x:Static pui:ThemedDialogColors.WindowPanelBrushKey}}"
    Foreground="{DynamicResource {x:Static pui:ThemedDialogColors.WindowPanelTextBrushKey}}"
    FocusManager.FocusedElement="{Binding ElementName=NameBox}"
    >
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- search + project type filter, like the shell's 'Create a new project' dialog -->
        <Grid
            Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
            Margin="0,0,0,8"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                Grid.Column="0"
                VerticalContentAlignment="Center"
                Padding="4,3,26,3"
                TextChanged="OnSearchChanged"
                PreviewKeyDown="OnSearchKeyDown"
                AutomationProperties.Name="Search for templates"
                />
            <TextBlock x:Name="SearchPlaceholder"
                Grid.Column="0"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0.6"
                Text="Search for templates"
                />
            <!-- own template: the themed dialog button style only shows its content on hover,
                 and its minimum size would push the glyph away from the box's right edge -->
            <Button x:Name="ClearSearchButton"
                Grid.Column="0"
                Width="22"
                MinWidth="0"
                MinHeight="0"
                Margin="0,2,2,2"
                HorizontalAlignment="Right"
                Cursor="Hand"
                Focusable="False"
                ToolTip="Clear search"
                Visibility="Collapsed"
                Click="OnClearSearch"
                AutomationProperties.Name="Clear search"
                >
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="Transparent" CornerRadius="2">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{Binding Foreground, ElementName=SearchBox}"
                                Text="&#xE711;"
                                />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#33808080"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#66808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <ComboBox x:Name="TypeFilter"
                Grid.Column="2"
                SelectionChanged="OnTypeChanged"
                AutomationProperties.Name="Project type"
                />
        </Grid>

        <!-- same layout as the shell's New Project dialog: categories | templates -->
        <Grid
            Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3"
            Height="300"
            >
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TreeView x:Name="CategoryTree"
                Grid.Column="0"
                Background="{DynamicResource {x:Static pui:TreeViewColors.BackgroundBrushKey}}"
                Foreground="{DynamicResource {x:Static pui:TreeViewColors.BackgroundTextBrushKey}}"
                BorderBrush="{Binding BorderBrush, ElementName=TemplateList}"
                SelectedItemChanged="OnCategoryChanged"
                AutomationProperties.Name="Categories"
                >
                <!-- the default TreeViewItem template paints with these system colors; the dialog theme
                     doesn't restyle tree items, so map them to the shell's tree colors -->
                <TreeView.Resources>
                    <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="{DynamicResource {x:Static pui:TreeViewColors.BackgroundTextColorKey}}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="{DynamicResource {x:Static pui:TreeViewColors.SelectedItemActiveColorKey}}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="{DynamicResource {x:Static pui:TreeViewColors.SelectedItemActiveTextColorKey}}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static pui:TreeViewColors.SelectedItemInactiveColorKey}}"/>
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static pui:TreeViewColors.SelectedItemInactiveTextColorKey}}"/>
                </TreeView.Resources>
                <TreeView.ItemContainerStyle>
                    <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                        <Setter Property="IsExpanded" Value="True"/>
                        <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                    </Style>
                </TreeView.ItemContainerStyle>
                <TreeView.ItemTemplate>
                    <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                        <TextBlock Margin="2,1" Text="{Binding Name}"/>
                    </HierarchicalDataTemplate>
                </TreeView.ItemTemplate>
            </TreeView>

            <ListBox x:Name="TemplateList"
                Grid.Column="2"
                HorizontalContentAlignment="Stretch"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                SelectionMode="Single"
                SelectionChanged="OnTemplateChanged"
                AutomationProperties.Name="Templates"
                >
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,4" ToolTip="{Binding Path}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <Image
                                Grid.Column="0"
                                Width="32" Height="32"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top"
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding Icon}"
                                />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                                <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Tags}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border
                                                Margin="0,0,6,2"
                                                Padding="6,1"
                                                Background="#33808080"
                                                CornerRadius="2"
                                                >
                                                <TextBlock FontSize="11" Text="{Binding}"/>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                            <TextBlock
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Category}"
                                TextTrimming="CharacterEllipsis"
                                />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock x:Name="NoMatchText"
                Grid.Column="2"
                Margin="12"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Opacity="0.8"
                Text="No templates match the search or the project type."
                TextWrapping="Wrap"
                Visibility="Collapsed"
                />
        </Grid>

        <TextBlock x:Name="DescriptionText"
            Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
            MinHeight="20"
            Margin="2,8,0,12"
            TextWrapping="Wrap"
            />

        <Label
            Grid.Row="3" Grid.Column="0"
            Margin="0,0,8,8"
            VerticalAlignment="Center"
            Content="Project _name:"
            Target="{Binding ElementName=NameBox}"
            />
        <TextBox x:Name="NameBox"
            Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2"
            Margin="0,0,0,8"
            VerticalContentAlignment="Center"
            TextChanged="OnInputChanged"
            />

        <Label
            Grid.Row="4" Grid.Column="0"
            Margin="0,0,8,0"
            VerticalAlignment="Center"
            Content="_Location:"
            Target="{Binding ElementName=LocationBox}"
            />
        <TextBox x:Name="LocationBox"
            Grid.Row="4" Grid.Column="1"
            VerticalContentAlignment="Center"
            TextChanged="OnLocationChanged"
            />
        <Button
            Grid.Row="4" Grid.Column="2"
            MinWidth="32"
            Margin="6,0,0,0"
            Content="..."
            ToolTip="Browse for a folder"
            Click="OnBrowse"
            />

        <TextBlock x:Name="MessageText"
            Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2"
            Margin="2,8,0,0"
            Opacity="0.8"
            TextWrapping="Wrap"
            />

        <StackPanel
            Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
            Margin="0,16,0,0"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            >
            <Button x:Name="CreateButton"
                MinWidth="80"
                Content="_Create"
                IsDefault="True"
                Click="OnCreate"
                />
            <Button
                MinWidth="80"
                Margin="8,0,0,0"
                Content="Cancel"
                IsCancel="True"
                />
        </StackPanel>
    </Grid>
</pui:DialogWindow>
