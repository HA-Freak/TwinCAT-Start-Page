<UserControl 
    x:Class="TwinCAT.XAE.StartPage.UI.Views.StartItems.StartItemsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
    xmlns:local="clr-namespace:TwinCAT.XAE.StartPage.UI.Views.StartItems"
    xmlns:c="clr-namespace:TwinCAT.XAE.StartPage.UI.Converters"
    xmlns:grid="clr-namespace:TwinCAT.XAE.StartPage.UI.AttachedProperties.Grids"
    xmlns:imaging="clr-namespace:Microsoft.VisualStudio.Imaging;assembly=Microsoft.VisualStudio.Imaging"
    xmlns:pui="clr-namespace:Microsoft.VisualStudio.PlatformUI;assembly=Microsoft.VisualStudio.Shell.15.0"
    mc:Ignorable="d" 
    d:DesignHeight="450" d:DesignWidth="800"
    >
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/TwinCAT.XAE.StartPage;component/Resources/Brushes.xaml"/>
                <ResourceDictionary Source="pack://application:,,,/TwinCAT.XAE.StartPage;component/Resources/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- https://docs.microsoft.com/en-us/dotnet/framework/wpf/controls/listview-styles-and-templates#listviewitem-states -->
    <!-- https://stackoverflow.com/questions/17188699/remove-the-mouse-over-effect-on-a-listview-in-wpf/17189210#17189210 -->
    <Border
        pui:ImageThemingUtilities.ImageBackgroundColor="{Binding Background.Color, RelativeSource={RelativeSource Self}}"
        Style="{StaticResource ColumnStyle}"
        Visibility="{Binding IsVisible, Converter={c:BoolToVisibilityConverter}}"
        >
        <DockPanel LastChildFill="true"><!-- Open/New Project-->
            <TextBlock x:Name="Heading"
                DockPanel.Dock="Top"
                Style="{StaticResource ColumnHeadingStyle}"
                Text="{Binding Heading}"
                />

            <ItemsControl x:Name="Commands"
                DockPanel.Dock="Bottom"
                Style="{StaticResource ColumnCommandsStyle}"
                />

            <ListView x:Name="StartItemsListView"
                IsTabStop="False"
                ItemsSource="{Binding Items}"
                Style="{StaticResource ColumnListStyle}"
                >
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <!-- name + one-line description: every item has the same height, so they're evenly spaced -->
                        <Setter Property="MinHeight" Value="0"/>
                        <Setter Property="Margin" Value="0,0,0,8"/>
                        <Setter Property="Padding" Value="5,3"/>
                        <Setter Property="IsTabStop" Value="False"/>
                        <Style.Triggers>
                            <!-- 'Create a new project' directly followed by its children -->
                            <DataTrigger Binding="{Binding HasChildren}" Value="True">
                                <Setter Property="Margin" Value="0,0,0,2"/>
                            </DataTrigger>
                            <!-- 'New ... Project...' links: one line each, close together, indented so their
                                 icons line up with the name of 'Create a new project' -->
                            <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                <Setter Property="Margin" Value="35,0,0,2"/>
                                <Setter Property="Padding" Value="5,1"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding IsGroupEnd}" Value="True">
                                <Setter Property="Margin" Value="35,0,0,8"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Button
                            Command="{Binding ClickCommand}"
                            IsTabStop="False"
                            Style="{StaticResource ColumnListItemStyle}"
                            >
                            <Grid grid:Props.ColumnWidths="45,*">
                                <imaging:CrispImage
                                    Name="StartItemImage"
                                    Grid.Column="0"
                                    Width="{Binding ImageSize}"
                                    Height="{Binding ImageSize}"
                                    Margin="{Binding Margin}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    Moniker="{Binding Moniker}"
                                    Visibility="{Binding HasImage, Converter={c:BoolToVisibilityConverter Reverse=True}}"
                                    />

                                <Image
                                    Grid.Column="0"
                                    Width="{Binding ImageSize}"
                                    Height="{Binding ImageSize}"
                                    Margin="{Binding Margin}"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Top"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding Image}"
                                    Visibility="{Binding HasImage, Converter={c:BoolToVisibilityConverter}}"
                                    />

                                <StackPanel x:Name="TextBlocks"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    HorizontalAlignment="Left"
                                    Orientation="Vertical"
                                    >
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>

                                    <TextBlock x:Name="StartItemName"
                                        Margin="0"
                                        Padding="5,0,5,0"
                                        HorizontalAlignment="Left"
                                        FontFamily="{StaticResource DefaultFont}"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource ItemNameBrush}"
                                        Text="{Binding Name}"
                                        TextWrapping="Wrap"
                                        >
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="FontSize" Value="16"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                                        <Setter Property="FontSize" Value="13"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- one line keeps all items the same height; the tooltip shows what's cut off -->
                                    <TextBlock x:Name="StartItemDescription"
                                        Margin="0"
                                        Padding="7,0,5,2"
                                        FontFamily="{StaticResource DefaultFont}"
                                        FontSize="12"
                                        FontWeight="Normal"
                                        Foreground="{DynamicResource ItemDescriptionBrush}"
                                        Text="{Binding Description}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap"
                                        ToolTip="{Binding Description}"
                                        Visibility="{Binding IsCompact, Converter={c:BoolToVisibilityConverter Reverse=True}}"
                                        />
                                </StackPanel>
                            </Grid>
                        </Button>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </DockPanel>
    </Border>
</UserControl>