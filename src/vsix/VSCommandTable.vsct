	<Commands package="StartPage">
		<Buttons>
			<!-- DN = 10, EL = 20, SP+ = 30 -->

			<Button guid="StartPage" id="FileWindow" priority="0x030" type="Button">
        <Parent guid="VSMainMenu" id="View.CodeGroup"/>
        <Icon guid="ImageCatalogGuid" id="ShowStartPage" />
				<CommandFlag>IconIsMoniker</CommandFlag>
        <!--CommandFlag>DynamicVisibility</CommandFlag-->
				<Strings>
					<ButtonText>Start Page TcXaeShell64</ButtonText>
					<CommandName>Start Page TcXaeShell64</CommandName>
					<CanonicalName>.File.StartPage</CanonicalName>
				</Strings>
			</Button>
		</Buttons>
	</Commands>

	<Symbols>
		<GuidSymbol name="StartPage" value="{6b4431b4-7dc5-40c7-bf16-8d7ebe2c4608}">
			<IDSymbol name="FileWindow" value="0x0210" />
		</GuidSymbol>
		<GuidSymbol name="StartPageWindow" value="{e3be6dd3-f017-4d6e-ae88-2b29319a77a2}" />
	</Symbols>
</CommandTable>
